<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pmz_member_tree" model="ir.ui.view">
        <field name="name">pmz.member.list</field>
        <field name="model">pmz.member</field>
        <field name="arch" type="xml">
            <list string="PMZ Members">
                <field name="image_1920" widget="image" options="{'size': [30, 30]}" string=" " optional="show"/>
                <field name="first_name" optional="show"/>
                <field name="middle_name" optional="show"/>
                <field name="last_name" optional="show"/>
                <field name="email" optional="show"/>
                <field name="prof_telephone" optional="show"/>
                <field name="prof_company_name_address" string="Company" optional="show"/>
                <field name="prof_present_position" string="Position" optional="show"/>
                <field name="prof_grading" string="Grading" optional="show"/>
                <field name="session" string="Session" optional="show"/>
                <field name="membership_status" string="Status" widget="badge" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_pmz_member_form" model="ir.ui.view">
        <field name="name">pmz.member.form</field>
        <field name="model">pmz.member</field>
        <field name="arch" type="xml">
            <form string="PMZ Member">
                <header>
                    <field name="membership_status" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="first_name" class="oe_edit_only" string="Member Name"/>
                        <h1>
                            <div class="d-flex flex-row gap-2">
                                <field name="first_name" placeholder="First Name"/>
                                <field name="middle_name" placeholder="Middle Name"/>
                                <field name="last_name" placeholder="Last Name"/>
                            </div>
                        </h1>
                    </div>
                    <group>
                        <group string="Personal Info">
                            <field name="prof_title"/>
                            <field name="birth_date"/>
                            <field name="gender" widget="radio" options="{'horizontal': true}"/>
                            <field name="prof_id_no"/>
                            <field name="prof_telephone"/>
                            <field name="email"/>
                        </group>
                        <group string="Professional Details">
                            <field name="session" widget="selection"/>
                            <field name="prof_company_name_address"/>
                            <field name="prof_present_position"/>
                            <field name="prof_highest_prof_qualifications"/>
                        </group>
                    </group>
                    <group string="Professional Classifications" col="6">
                        <group colspan="2">
                            <field name="prof_grading" widget="radio"/>
                        </group>
                        <group colspan="2">
                            <field name="prof_industry_affiliation" widget="radio"/>
                        </group>
                        <group colspan="2">
                            <field name="prof_job_function" widget="radio"/>
                        </group>
                    </group>
                    <group>
                        <group string="Address &amp; Contacts">
                            <field name="prof_residential_address"/>
                            <field name="prof_postal_address"/>
                        </group>
                        <group string="Other Information">
                            <field name="prof_chapter"/>
                            <field name="prof_pmp"/>
                            <field name="prof_year"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_pmz_member" model="ir.actions.act_window">
        <field name="name">Professional Members</field>
        <field name="res_model">pmz.member</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
