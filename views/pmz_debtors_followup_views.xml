<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pmz_debtors_follow_up_tree" model="ir.ui.view">
        <field name="name">pmz.debtors.follow.up.tree</field>
        <field name="model">pmz.member</field>
        <field name="arch" type="xml">
            <list string="Debtors Follow Up" create="0" delete="0">
                <field name="image_1920" widget="image" options="{'size': [30, 30]}" string=" " optional="hide"/>
                <field name="first_name" optional="show"/>
                <field name="middle_name" optional="hide"/>
                <field name="last_name" optional="show"/>
                <field name="prof_id_no" string="ID No." optional="hide"/>
                <field name="prof_grading" string="Grading" optional="show"/>
                <field name="phone" optional="show"/>
                <field name="email" optional="show"/>
                <field name="prof_company_name_address" string="Company" optional="hide"/>
                <field name="prof_present_position" string="Position" optional="hide"/>
                <field name="outstanding_balance" string="Balance" widget="monetary" optional="show"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="activity_date_deadline" string="Due Date" optional="show"/>
                <field name="activity_note" string="Activity Log Note" widget="html" optional="show"/>
                <field name="membership_status" string="Status" widget="badge" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="action_pmz_debtors_follow_up" model="ir.actions.act_window">
        <field name="name">Debtors Follow Up</field>
        <field name="res_model">pmz.member</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('outstanding_balance', '&gt;', 0)]</field>
        <field name="view_id" ref="view_pmz_debtors_follow_up_tree"/>
    </record>
</odoo>
