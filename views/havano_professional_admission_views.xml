<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_havano_professional_admission" model="ir.sequence">
            <field name="name">Professional Admission Sequence</field>
            <field name="code">havano.professional.admission</field>
            <field name="prefix">PROF-APP-</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>

    <record id="view_havano_professional_admission_form" model="ir.ui.view">
        <field name="name">havano.professional.admission.form</field>
        <field name="model">havano.professional.admission</field>
        <field name="arch" type="xml">
            <form string="Professional Admission">
                <header>
                    <button name="action_approve" type="object" string="Approve" class="btn-primary" invisible="state != 'submitted'"/>
                    <button name="action_reject" type="object" string="Disapprove" class="btn-danger" invisible="state != 'submitted'"/>
                    <button name="action_waitlist" type="object" string="Add to Waiting List" class="btn-secondary" invisible="state != 'submitted'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,approved,rejected"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Personal Information">
                            <field name="first_name"/>
                            <field name="middle_name"/>
                            <field name="surname"/>
                            <field name="title"/>
                            <field name="dob"/>
                            <field name="id_no"/>
                            <field name="pmp"/>
                            <field name="year"/>
                            <field name="highest_prof_qualifications"/>
                        </group>
                        <group string="Contact &amp; Grading">
                            <field name="email"/>
                            <field name="telephone"/>
                            <field name="present_position"/>
                            <field name="company_name_address"/>
                            <field name="residential_address"/>
                            <field name="postal_address"/>
                            <field name="chapter"/>
                            <field name="grading"/>
                            <field name="session" widget="selection"/>
                            <field name="application_fee" readonly="1" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                        </group>
                    </group>

                    <!-- Payment & Billing Verification Section -->
                    <group string="Payment &amp; Billing Verification">
                        <group>
                            <field name="is_paid" widget="boolean_toggle"/>
                            <field name="amount_paid" invisible="not is_paid" required="is_paid"/>
                            <field name="journal_id" options="{'no_create': True}" invisible="not is_paid" required="is_paid"/>
                            <button name="action_register_auto_payment" type="object" string="Process Payment" class="btn-success btn-sm mt-2" invisible="not is_paid"/>
                        </group>
                        <group>
                            <field name="proof_of_payment" filename="proof_of_payment_filename" widget="binary"/>
                            <field name="proof_of_payment_filename" invisible="1"/>
                            <field name="invoice_id" readonly="1"/>
                            <field name="payment_id" readonly="1" invisible="not payment_id"/>
                        </group>
                    </group>

                    <group>
                        <group string="Industry Affiliation">
                            <field name="industry_affiliation"/>
                        </group>
                        <group string="Job Function">
                            <field name="job_function"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="activity_ids" widget="mail_activity"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_havano_professional_admission_tree" model="ir.ui.view">
        <field name="name">havano.professional.admission.tree</field>
        <field name="model">havano.professional.admission</field>
        <field name="arch" type="xml">
            <list string="Professional Admissions">
                <field name="name" optional="show"/>
                <field name="first_name" optional="show"/>
                <field name="middle_name" optional="hide"/>
                <field name="surname" optional="show"/>
                <field name="email" optional="show"/>
                <field name="telephone" optional="show"/>
                <field name="grading" optional="show"/>
                <field name="application_fee" optional="show"/>
                <field name="is_paid" widget="boolean" optional="show"/>
                <field name="amount_paid" optional="hide"/>
                <field name="invoice_id" optional="hide"/>
                <field name="pmp" optional="hide"/>
                <field name="industry_affiliation" optional="hide"/>
                <field name="state" widget="badge" decoration-success="state == 'approved'" decoration-danger="state == 'rejected'" decoration-info="state == 'submitted'" decoration-warning="state == 'waiting_list'" optional="show"/>
            </list>
        </field>
    </record>

    <record id="action_havano_professional_admission" model="ir.actions.act_window">
        <field name="name">Professional Admissions</field>
        <field name="res_model">havano.professional.admission</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
